# Base de datos EXCLUSIVA para pruebas: las pruebas BORRAN y recrean las tablas.
# La URL debe contener "test". Nunca uses la base de Supabase de producción.
# Con Docker:  docker compose up -d db && docker compose exec db createdb -U smartbudget smartbudget_test
TEST_DATABASE_URL=postgresql://smartbudget:smartbudget@localhost:5432/smartbudget_test
TEST_DB_SSL=false
